{
  "name": "carnot",
  "displayName": "Carnot",
  "description": "Chat with Claude, ChatGPT, Gemini, ZCode, DeepSeek or Doubao in VS Code, with one memory and one set of skills shared with the Carnot app.",
  "version": "0.1.1",
  "publisher": "carnot-local",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["AI", "Chat"],
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "viewsContainers": {
      "activitybar": [{ "id": "carnot", "title": "Carnot", "icon": "media/icon.svg" }]
    },
    "views": {
      "carnot": [{ "type": "webview", "id": "carnot.chat", "name": "对话" }]
    },
    "commands": [
      { "command": "carnot.newChat", "title": "Carnot: 新对话", "icon": "$(add)" },
      { "command": "carnot.history", "title": "Carnot: 历史对话", "icon": "$(history)" },
      { "command": "carnot.connections", "title": "Carnot: 连接设置", "icon": "$(plug)" },
      { "command": "carnot.openMemory", "title": "Carnot: 打开共享记忆" },
      { "command": "carnot.askSelection", "title": "Carnot: 询问选中的代码" }
    ],
    "menus": {
      "view/title": [
        { "command": "carnot.newChat", "when": "view == carnot.chat", "group": "navigation@1" },
        { "command": "carnot.history", "when": "view == carnot.chat", "group": "navigation@2" },
        { "command": "carnot.connections", "when": "view == carnot.chat", "group": "navigation@3" }
      ],
      "editor/context": [
        { "command": "carnot.askSelection", "when": "editorHasSelection", "group": "navigation" }
      ]
    },
    "configuration": {
      "title": "Carnot",
      "properties": {
        "carnot.serverDir": {
          "type": "string",
          "default": "",
          "description": "Folder with carnot_agent.py. Empty: the one recorded in ~/.carnot/server_dir."
        },
        "carnot.permissionMode": {
          "type": "string",
          "default": "auto",
          "enum": ["plan", "acceptEdits", "auto", "bypassPermissions"],
          "description": "What the AI may do without asking; also in the chat view. plan: reads only. acceptEdits: may edit files. auto: routine actions proceed, risky ones are blocked. bypassPermissions: anything, unasked. There is no way to answer a prompt here, so an action that would need approval fails instead."
        }
      }
    }
  }
}
